# Files that scripts/lint-qariah-owned.mjs must not lint (TECH_DEBT #236).
#
# The script lints the Qariah-owned files: the tracked files that are not in the
# upstream tree at the pinned commit (scripts/lint-qariah-owned.upstream-sha).
