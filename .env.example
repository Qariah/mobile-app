# Bayaan app environment variables
# Copy this file to .env and fill in the values

# ── Bayaan Backend API ────────────────────────────────────────────────────────
# Community contributors: get the community key from CONTRIBUTING.md
# Leave blank to use the bundled reciter data instead (no API calls made)
EXPO_PUBLIC_BAYAAN_API_URL=https://api.thebayaan.com
EXPO_PUBLIC_BAYAAN_API_KEY=

# Optional killswitch endpoint. When set, the app fetches this URL on launch
# and respects `useBackendApi: false` to fall back to bundled data. Leave
# blank for forks/self-hosters — the check is skipped entirely, no request
# is made on launch.
EXPO_PUBLIC_KILLSWITCH_URL=

# ── Build identity (fork-configurable) ────────────────────────────────────────
# Apple Developer Team ID. Used by app.config.js and the withIOSTeam config
# plugin to set DEVELOPMENT_TEAM in the generated Xcode project. Forks must
# set their own; if blank the maintainer's ID is used and iOS builds will
# fail with a signing error (intentional — prevents accidental misuse).
APPLE_TEAM_ID=

# Expo / EAS project ID (UUID). Drives `expo.extra.eas.projectId` and the
# OTA updates URL. When this is blank, OTA updates are disabled entirely
# (the app does not phone home on launch). The maintainer sets this in a
# local .env. Forks wanting OTA updates must set their own EAS project ID.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Universal-link / deep-link domain. When set, registers iOS associated
# domains and Android intent filters (autoVerify) for this host so links
# like https://<domain>/quran/... open the app. Leave blank on forks to
# skip deep-link registration entirely and avoid conflicts.
EXPO_PUBLIC_ASSOCIATED_DOMAIN=

# Privacy policy URL surfaced in Info.plist / NSPrivacyPolicyURL. Forks
# MUST override this — shipping the maintainer's privacy policy in a
# different app is misleading and may violate store policies.
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# ── Analytics & Crash Reporting ───────────────────────────────────────────────
# PostHog project API key (phc_*) from app.posthog.com. Hardcoded to the US cloud
# endpoint in app/_layout.tsx. Leave blank to build without analytics — capture
# calls no-op when the SDK isn't connected.
EXPO_PUBLIC_POSTHOG_API_KEY=

# Sentry DSN for crash reporting. Blank skips Sentry.init AND removes the
# @sentry/react-native/expo config plugin, so `expo prebuild` won't add the
# source-map / debug-symbol upload build phases. Forks without a DSN can
# clone → prebuild → archive with no Sentry setup.
EXPO_PUBLIC_SENTRY_DSN=

# Override the Sentry org/project slugs used by the Expo plugin when a DSN
# is set. Only needed if you point EXPO_PUBLIC_SENTRY_DSN at your own Sentry
# project. SENTRY_AUTH_TOKEN (secret, not stored here) is required for the
# source-map upload to succeed.
SENTRY_ORG=
SENTRY_PROJECT=

# Set to 'false' to disable all analytics + crash reporting without cutting a
# release. Defaults to enabled.
EXPO_PUBLIC_ANALYTICS_ENABLED=true

# ── Supabase (legacy — no longer required for core app features) ──────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ══ QARIAH additions. Keep upstream's lines above byte-identical, so a sync does not conflict here. ══
# Copy this file to `.env.local` (gitignored). ONBOARDING.md says which keys are shared and which are owner-only.
# Keep the inherited `BAYAAN_` / `EXPO_PUBLIC_BAYAAN_` variable names: they are intentional.
# Upstream keys above: leave EXPO_PUBLIC_BAYAAN_API_KEY and SUPABASE_* blank (unused). A blank APPLE_TEAM_ID
# makes iOS signing fail (intentional).

# ══ [1] DEV BUILD — the minimum to run the app on a simulator or emulator ══

# Quran Foundation OAuth client. Shared dev secret (ONBOARDING.md); the prelive client is confidential (TECH_DEBT #53).
EXPO_PUBLIC_QF_ENV=prelive                 # prelive | production
EXPO_PUBLIC_QF_CLIENT_ID=                  # OAuth client id; defaults to dev client
EXPO_PUBLIC_QF_CLIENT_SECRET=              # prelive client secret (TECH_DEBT #53; baked into the bundle today)
EXPO_PUBLIC_QF_REDIRECT_URI=               # default: com.qariah.app:/quranoauth2redirect

# Catalog CDN URLs (values in the shared vault). Unset uses the bundled fallback catalog.
EXPO_PUBLIC_CATALOG_URL=https://cdn.example.com/catalog/catalog-v1.json
EXPO_PUBLIC_CATALOG_VERSION_URL=https://cdn.example.com/catalog/catalog-version.json
EXPO_PUBLIC_TIMESTAMP_CDN_BASE=https://cdn.example.com/timestamps
EXPO_PUBLIC_R2_MIGRATION_PUBLIC_HOST=your-public-bucket.example

# ══ [2] APP RUNTIME CONFIG (optional) ══

# Asset proxy: true rewrites LEGACY_HOST audio and photo URLs to PROXY_HOST. Turn it on only after the Worker is live.
EXPO_PUBLIC_ASSET_PROXY_ENABLED=false
EXPO_PUBLIC_ASSET_PROXY_HOST=media.cdn.example.com
EXPO_PUBLIC_ASSET_LEGACY_HOST=cdn.example.com

# ══ [3] ANALYTICS & CRASH REPORTING (optional for a dev build) ══

# Diagnostics: the live toggle is the PostHog `diagnostics_mode` flag. Set true only for a one-off diagnostic APK:
#   EXPO_PUBLIC_DIAGNOSTIC_MODE=true ./scripts/android-archive.sh
EXPO_PUBLIC_DIAGNOSTIC_MODE=

# Sentry masked replay: 'true' enables on-error replay (a publish-time setting). The rate (0..1) adds full sessions.
EXPO_PUBLIC_SENTRY_REPLAY=
EXPO_PUBLIC_SENTRY_REPLAY_SESSION_RATE=

# ══ [4] MAINTAINER / PUBLISHING — OWNER-ONLY. Never give these to collaborators. ══
# The values live in the maintainer's .env.local and the 1Password "Qariah — Infra Secrets" vault (DISASTER_RECOVERY.md).

# --- iOS publishing (TestFlight / App Store) ---
# App Store Connect API key ids. The .p8 file is at ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8.
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=

# --- Android signing + publishing ---
# These unlock ~/.android/keystores/qariah-upload-key.jks. Back the file up: a loss forces a Play upload-key reset.
QARIAH_UPLOAD_KEY_ALIAS=
QARIAH_UPLOAD_KEY_PASSWORD=
QARIAH_UPLOAD_STORE_PASSWORD=
# Play Developer API service-account JSON (a path or inline JSON); ~/.android/play-service-account.json (TECH_DEBT #94).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- Store listing URLs (surfaced in-app, e.g. "rate us") ---
APP_STORE_URL=
APP_STORE_BETA_URL=
PLAY_STORE_URL=

# --- QF production OAuth (used by prod archives; prelive is the dev default) ---
QF_PROD_CLIENT_ID=
QF_PROD_SECRET=

# --- Sentry source-map upload (archive-time; maintainer's Sentry project) ---
SENTRY_AUTH_TOKEN=

# --- PostHog query API (the diagnostics and signals scripts + GH Actions) ---
POSTHOG_PERSONAL_API_TOKEN=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=

# --- Cloudflare R2 (catalog/audio admin — scripts only, NOT app runtime) ---
# The account id, the R2 S3 API key pair, the bucket names, and the public hosts (no trailing slash).
CF_ACCT_ID=
CF_ACCESS_ID=
CF_SECRET_KEY=
CF_BUCKET=
CF_MIGRATION_BUCKET=
CDN_DOMAIN=
R2_MIGRATION_PUBLIC_HOST=

# --- v1 user-data migration extractor (scripts/extract-v1-migration.ts) ---
# READ-ONLY MongoDB connection to api.qariah.app. Never write; never call api-v2.
MONGO_URL=
# Api-Access-Token header for api.v3.qariah.app (defaults to 'Qariah-APP'); set if rotated.
QARIAH_API_TOKEN=

# --- Automated QA login (optional; used by QA harness) ---
QA_TEST_EMAIL=
QA_TEST_PASSWORD=
