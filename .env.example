# Qariah v2 — environment variables template
#
# Copy this file to `.env.local` (gitignored) and fill in the values you need.
# NOT every key is required to run a dev build — see the section dividers below.
# New collaborators: read ONBOARDING.md first. It maps which of these you need,
# which are shared secrets vs per-developer, and which are MAINTAINER-ONLY
# (signing keys, prod credentials — you will NOT be given these).
#
# Qariah is a fork of thebayaan/Bayaan; some inherited variable NAMES still carry
# the `BAYAAN_` / `EXPO_PUBLIC_BAYAAN_` prefix (the keystore alias, the upstream
# content API). Those names are intentional — don't rename them.
#
# Sections:
#   [1] Dev build — minimum to clone → run the app
#   [2] App runtime config — read by the app at launch (EXPO_PUBLIC_*)
#   [3] Analytics & crash reporting
#   [4] MAINTAINER / publishing — owner-only. Signing + store + R2 + backend.
#       These do NOT belong in a collaborator's .env.local.

# ══════════════════════════════════════════════════════════════════════════════
# [1] DEV BUILD — minimum to clone → run the app on a sim/emulator
# ══════════════════════════════════════════════════════════════════════════════

# Quran Foundation OAuth2 PKCE client (sign-in / user-state sync). Defaults in
# services/auth/config.ts point at the public dev (prelive) client. The prelive
# client is currently CONFIDENTIAL, so a client secret is required until QF
# issues a public client (TECH_DEBT #53). Shared dev secret — see ONBOARDING.md.
EXPO_PUBLIC_QF_ENV=prelive                 # prelive | production
EXPO_PUBLIC_QF_CLIENT_ID=                  # OAuth client id; defaults to dev client
EXPO_PUBLIC_QF_CLIENT_SECRET=              # prelive client secret (TECH_DEBT #53; baked into the bundle today)
EXPO_PUBLIC_QF_REDIRECT_URI=               # default: com.qariah.app:/quranoauth2redirect

# Catalog source (Qariah path). The app reads reciters/audio/version/timestamps
# from these CDN URLs. Unset = bundled fallback catalog (offline-capable; the
# `bundleFirstCatalog` flag seeds from the bundle on first launch). For a normal
# dev build, point these at the live Qariah CDN (values in the shared vault).
EXPO_PUBLIC_CATALOG_URL=https://cdn.example.com/catalog/catalog-v1.json
EXPO_PUBLIC_CATALOG_VERSION_URL=https://cdn.example.com/catalog/catalog-version.json
EXPO_PUBLIC_TOP_RECITERS_URL=https://cdn.example.com/stats/top-reciters.json
EXPO_PUBLIC_TIMESTAMP_CDN_BASE=https://cdn.example.com/timestamps
EXPO_PUBLIC_R2_MIGRATION_PUBLIC_HOST=your-public-bucket.example

# ══════════════════════════════════════════════════════════════════════════════
# [2] APP RUNTIME CONFIG — read by the app at launch (optional / fork-tunable)
# ══════════════════════════════════════════════════════════════════════════════

# Apple Developer Team ID. Used by app.config.ts + the withIOSTeam plugin to set
# DEVELOPMENT_TEAM in the Xcode project. Blank → the maintainer's ID is used and
# iOS builds fail with a signing error (intentional — prevents accidental misuse).
APPLE_TEAM_ID=

# Expo / EAS project ID (UUID). Drives expo.extra.eas.projectId + the OTA-updates
# URL. Blank → OTA updates disabled (app does not phone home on launch).
EXPO_PUBLIC_EAS_PROJECT_ID=

# Universal-link / deep-link domain. Set → registers iOS associated domains +
# Android intent filters (autoVerify) for this host. Blank → skip registration.
EXPO_PUBLIC_ASSOCIATED_DOMAIN=

# Privacy policy URL surfaced in Info.plist / NSPrivacyPolicyURL. Forks MUST
# override — shipping the maintainer's policy in a different app violates store
# policy.
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Asset access gating (Sprint 28). ENABLED=true rewrites audio + photo URLs on
# LEGACY_HOST → PROXY_HOST (the media-proxy Worker fronting the private bucket).
# Default unset/false = no rewrite. Set PROXY_HOST only after the Worker is live.
EXPO_PUBLIC_ASSET_PROXY_ENABLED=false
EXPO_PUBLIC_ASSET_PROXY_HOST=media.cdn.example.com
EXPO_PUBLIC_ASSET_LEGACY_HOST=cdn.example.com

# Upstream Bayaan content API (inherited). Qariah reads its catalog from R2, so
# this is normally left blank (no API calls made). Community contributors wanting
# the upstream API get the key from Bayaan's CONTRIBUTING.md.
EXPO_PUBLIC_BAYAAN_API_URL=https://api.thebayaan.com
EXPO_PUBLIC_BAYAAN_API_KEY=

# Optional killswitch endpoint. Set → app fetches it on launch and can fall back
# to bundled data. Blank → check skipped, no request made.
EXPO_PUBLIC_KILLSWITCH_URL=

# ══════════════════════════════════════════════════════════════════════════════
# [3] ANALYTICS & CRASH REPORTING (optional for a dev build — capture no-ops)
# ══════════════════════════════════════════════════════════════════════════════

# PostHog project API key (phc_*) from app.posthog.com (US cloud). Blank → builds
# without analytics; capture calls no-op when the SDK isn't connected.
EXPO_PUBLIC_POSTHOG_API_KEY=

# Sentry DSN. Blank → skips Sentry.init AND removes the @sentry/react-native/expo
# config plugin, so `expo prebuild` won't add the source-map upload build phases.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry org/project slugs used by the Expo plugin when a DSN is set. The
# source-map upload also needs SENTRY_AUTH_TOKEN (maintainer-only, section [4]).
SENTRY_ORG=
SENTRY_PROJECT=

# 'false' disables all analytics + crash reporting without a release. Default on.
EXPO_PUBLIC_ANALYTICS_ENABLED=true

# Diagnostics (freeze/hang catch-all — services/diagnostics/diagnostics.ts).
# Normally OFF here. The production toggle is the PostHog `diagnostics_mode`
# feature flag (live, no rebuild — see docs/operations/diagnostics-and-release-health.md);
# this env var only force-bakes diagnostics ON for a one-off diagnostic APK:
#   EXPO_PUBLIC_DIAGNOSTIC_MODE=true ./scripts/android-archive.sh
EXPO_PUBLIC_DIAGNOSTIC_MODE=

# Sentry Session Replay (masked). init-time setting, so it's a PUBLISH-time
# toggle (not the live flag). 'true' enables masked on-error replay. Recommended
# ON for the public beta, decide per-release for prod. Optional full-session
# sampling 0..1 (default 0 → on-error only).
EXPO_PUBLIC_SENTRY_REPLAY=
EXPO_PUBLIC_SENTRY_REPLAY_SESSION_RATE=

# ══════════════════════════════════════════════════════════════════════════════
# [4] MAINTAINER / PUBLISHING — OWNER-ONLY. Do NOT give these to collaborators.
#     These never have values committed here; they live in the maintainer's
#     .env.local + the 1Password "Qariah — Infra Secrets" vault (DISASTER_RECOVERY.md).
#     Listed so the FULL secret surface is documented for machine restore.
# ══════════════════════════════════════════════════════════════════════════════

# --- iOS publishing (TestFlight / App Store) ---
# App Store Connect API key (key id + issuer id). The .p8 itself lives at
# ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 (NOT an env var).
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=

# --- Android signing + publishing ---
# Upload keystore at ~/.android/keystores/qariah-upload-key.jks (NOT an env var —
# back it up; loss forces a Play upload-key reset). These unlock it:
QARIAH_UPLOAD_KEY_ALIAS=
QARIAH_UPLOAD_KEY_PASSWORD=
QARIAH_UPLOAD_STORE_PASSWORD=
# Google Play Developer API service-account JSON (path to the file, or inline JSON).
# File at ~/.android/play-service-account.json. Blocked from auto-creation by a GCP
# org policy on some accounts — see TECH_DEBT #94.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- Store listing URLs (surfaced in-app, e.g. "rate us") ---
APP_STORE_URL=
APP_STORE_BETA_URL=
PLAY_STORE_URL=

# --- QF production OAuth (used by prod archives; prelive is the dev default) ---
QF_PROD_CLIENT_ID=
QF_PROD_SECRET=

# --- Sentry source-map upload (archive-time; maintainer's Sentry project) ---
SENTRY_AUTH_TOKEN=

# --- PostHog publishing (scripts/publish-trending-reciters.mjs + GH Action) ---
POSTHOG_PERSONAL_API_TOKEN=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=

# --- Cloudflare R2 (catalog/audio admin — scripts only, NOT app runtime) ---
#   CF_ACCT_ID            Cloudflare account id (32 hex)
#   CF_ACCESS_ID          R2 S3 API access key id
#   CF_SECRET_KEY         R2 S3 API secret access key
#   CF_BUCKET             audio bucket name (e.g. your-audio-bucket)
#   CF_MIGRATION_BUCKET   one-shot v1 user-migration bucket (Sprint 11)
#   CDN_DOMAIN            public CDN host for audio
#   R2_MIGRATION_PUBLIC_HOST  public host for the migration bucket (no trailing slash)
CF_ACCT_ID=
CF_ACCESS_ID=
CF_SECRET_KEY=
CF_BUCKET=
CF_MIGRATION_BUCKET=
CDN_DOMAIN=
R2_MIGRATION_PUBLIC_HOST=

# --- v1 user-data migration extractor (scripts/extract-v1-migration.ts) ---
# READ-ONLY MongoDB connection to api.qariah.app. Never write; never call api-v2.
MONGO_URL=
# Api-Access-Token header for api.v3.qariah.app (defaults to 'Qariah-APP'); set if rotated.
QARIAH_API_TOKEN=

# --- Automated QA login (optional; used by QA harness) ---
QA_TEST_EMAIL=
QA_TEST_PASSWORD=
